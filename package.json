{
  "name": "design-portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:build": "node tools/des-art-admin/build.mjs",
    "dev": "next dev",
    "build": "npm run portfolio:build",
    "start": "npm run portfolio:start",
    "lint": "eslint",
    "release:package": "node tools/portfolio-release/package-runtime.mjs",
    "portfolio:build": "node --experimental-strip-types tools/portfolio-runtime/build.mjs",
