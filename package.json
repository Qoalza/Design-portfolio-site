    "portfolio:package": "node --experimental-strip-types tools/portfolio-runtime/package.mjs",
    "cms:build": "node tools/payload-admin/scripts/run.mjs build",
    "cms:package": "node tools/payload-admin/scripts/package.mjs",
    "cms:verify": "node tools/portfolio-runtime/verify-cms.mjs",
