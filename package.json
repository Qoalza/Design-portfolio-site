  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "lenis": "1.3.25",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.2",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
