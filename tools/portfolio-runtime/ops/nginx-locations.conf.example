# Route-only template for the existing approved HTTPS server. Keep SSL/redirects.
# Review actual paths/ports/proxy headers at G7; do not replace a server wholesale.
location ^~ /__internal/ { return 404; }
location ^~ /api/internal/ { return 404; }
location = /__internal { return 404; }
location = /api/internal { return 404; }

location ~ ^/(admin(?:/|$)|_next/|payload-assets/|api(?:/|$)|preview(?:/|$)) {
 proxy_pass http://127.0.0.1:3102;
 proxy_set_header Host $host;
 proxy_set_header X-Forwarded-Host $host;
 proxy_set_header X-Forwarded-Proto $scheme;
 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
location / {
 proxy_pass http://127.0.0.1:3101;
 proxy_set_header Host $host;
 proxy_set_header X-Forwarded-Host $host;
 proxy_set_header X-Forwarded-Proto $scheme;
 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
